# LJ liquid-vapor surface tension from the global pressure tensor.
# gamma = 0.5 * Lz * (Pzz - (Pxx + Pyy)/2), two interfaces.

units           lj
atom_style      atomic
boundary        p p p

lattice         fcc 0.8
region          box block 0 6 0 6 0 24
create_box      1 box
region          liquid block 0 6 0 6 6 18
create_atoms    1 region liquid

mass            1 1.0
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0

velocity        all create 0.85 4928459 mom yes rot yes dist gaussian
fix             nvt all nvt temp 0.85 0.85 1.0
timestep        0.005
thermo          100

run             30000
unfix           nvt
fix             nve all nve

variable        gamma equal 0.5*lz*(pzz-0.5*(pxx+pyy))
fix             ave all ave/time 10 100 1000 v_gamma ave running
thermo_style    custom step temp pxx pyy pzz v_gamma
run             1000000

print           "GAMMA_RESULT $(f_ave)"
