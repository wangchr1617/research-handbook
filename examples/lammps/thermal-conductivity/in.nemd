# LJ 液体热导率：非平衡 Müller-Plathe 速度交换法（NEMD）。
# 用法：lmp -in in.nemd；结果同时写入 profile.nemd 与 log.nemd。

variable x index 10
variable y index 10
variable z equal 20
variable rho equal 0.6
variable t equal 1.35
variable rc equal 2.5
variable nequil index 5000
variable nsteady index 20000
variable nprod index 40000

units lj
atom_style atomic
lattice fcc ${rho}
region box block 0 $x 0 $y 0 $z
create_box 1 box
create_atoms 1 box
mass 1 1.0
velocity all create $t 87287
pair_style lj/cut ${rc}
pair_coeff 1 1 1.0 1.0
neighbor 0.3 bin
neigh_modify delay 0 every 1

fix 1 all nvt temp $t $t 0.5
thermo 1000
run ${nequil}
velocity all scale $t
unfix 1

compute ke all ke/atom
variable temp atom c_ke/1.5
fix 1 all nve
compute layers all chunk/atom bin/1d z lower 0.05 units reduced
fix 2 all ave/chunk 10 100 1000 layers v_temp file profile.nemd
# 每 10 步在冷/热层之间交换速度，等价于沿 z 输运能量。
fix 3 all thermal/conductivity 10 z 20

variable tdiff equal f_2[11][3]-f_2[1][3]
thermo_style custom step temp epair etotal f_3 v_tdiff
thermo_modify colname f_3 E_delta colname v_tdiff dTemp_step
thermo 1000
run ${nsteady}

# 重新定义 fix，使 f_3 的累积能量从生产段零点开始。
fix 3 all thermal/conductivity 10 z 20
variable start_time equal time
fix ave all ave/time 1 1 1000 v_tdiff ave running
variable kappa equal (f_3/(time-${start_time})/(lx*ly)/2.0)*(lz/2.0)/f_ave
variable Lx equal lx
variable Ly equal ly
variable Lz equal lz
thermo_style custom step temp epair etotal f_3 v_tdiff f_ave
thermo_modify colname f_3 E_delta colname v_tdiff dTemp_step colname f_ave dTemp
run ${nprod}
print "NEMD_RESULT $(f_3:%.6f) $(f_ave:%.6f) $(v_kappa:%.6f) $(v_Lx:%.6f) $(v_Ly:%.6f) $(v_Lz:%.6f) $(time:%.6f)"
