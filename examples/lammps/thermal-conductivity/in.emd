# LJ 液体热导率：平衡态 Green-Kubo（EMD）。
# 用法：lmp -in in.emd；结果同时写入 profile.heatflux 与 log.emd。

variable x index 10
variable y index 10
variable z equal 10
variable rho equal 0.6
variable t equal 1.35
variable rc equal 2.5
variable nequil index 5000
variable nprod index 100000
variable p index 200
variable s index 10
variable d equal $p*$s

units lj
atom_style atomic
lattice fcc ${rho}
region box block 0 $x 0 $y 0 $z
create_box 1 box
create_atoms 1 box
mass 1 1.0
velocity all create $t 87287
pair_style lj/cut ${rc}
pair_coeff 1 1 1.0 1.0
neighbor 0.3 bin
neigh_modify delay 0 every 1

# 先让液体忘记初始 fcc 排列，再进入 NVE 采样。
fix 1 all nvt temp $t $t 0.5
thermo 1000
run ${nequil}
velocity all scale $t
unfix 1

reset_timestep 0
compute myKE all ke/atom
compute myPE all pe/atom
compute myStress all stress/atom NULL virial
compute flux all heat/flux myKE myPE myStress
variable Jx equal c_flux[1]/vol
variable Jy equal c_flux[2]/vol
variable Jz equal c_flux[3]/vol
fix 1 all nve
# 每 10 步采样，200 个延迟点，每 2000 步输出一个运行平均块。
fix JJ all ave/correlate $s $p $d c_flux[1] c_flux[2] c_flux[3] type auto file profile.heatflux ave running
variable scale equal $s*dt/$t/$t/vol
variable k11 equal trap(f_JJ[3])*${scale}
variable k22 equal trap(f_JJ[4])*${scale}
variable k33 equal trap(f_JJ[5])*${scale}
variable kappa equal (v_k11+v_k22+v_k33)/3.0
variable volume equal vol
thermo $d
thermo_style custom step temp v_Jx v_Jy v_Jz v_k11 v_k22 v_k33 v_kappa
thermo_modify colname v_Jx Jx colname v_Jy Jy colname v_Jz Jz colname v_k11 kappa_11 colname v_k22 kappa_22 colname v_k33 kappa_33 colname v_kappa kappa
run ${nprod}
print "EMD_RESULT $(v_kappa:%.6f) $(v_volume:%.6f)"
