units lj
atom_style atomic
boundary p p p
pair_style lj/cut 2.5
read_data equilibrated.data
pair_coeff 1 1 1 1
change_box all x scale 0.999 remap
minimize 1e-12 1e-12 3000 20000
thermo_style custom step pe pxx pyy pzz pxy vol
run 0
variable xx equal pxx
variable yy equal pyy
variable zz equal pzz
variable xy equal pxy
variable volume equal vol
print "${xx} ${yy} ${zz} ${xy} ${volume}" file stress.dat
