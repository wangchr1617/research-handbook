# 三维 LJ 液体：先 NVT 平衡，再 NVE 采样。
units lj
atom_style atomic
boundary p p p
lattice fcc 0.75
region box block 0 4 0 4 0 4
create_box 1 box
create_atoms 1 box
mass 1 1.0
pair_style lj/cut 2.5
pair_coeff * * 1 1
pair_modify shift yes
neighbor 0.3 bin
neigh_modify every 1 delay 0 check yes
timestep 0.005
velocity all create 1.2 435671 mom yes rot no dist gaussian
fix equil all nvt temp 1.2 1.2 0.5
thermo 500
thermo_style custom step temp pe etotal
thermo_modify norm no
run 5000
unfix equil
reset_timestep 0
fix dynamics all nve
compute motion all msd com yes
fix sample all ave/time 100 1 100 c_motion[1] c_motion[2] c_motion[3] c_motion[4] file msd.dat format "%20.12g"
variable temperature equal temp
variable total_energy equal etotal
fix thermal all ave/time 100 1 100 v_temperature v_total_energy file energy.dat format "%20.12g"
dump trajectory all custom 100 trajectory.dump id type xu yu zu
dump_modify trajectory sort id format float %.12g
run 10000
