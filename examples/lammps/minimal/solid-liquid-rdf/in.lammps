# 相同密度的低温固体与高温液体；每个温度独立初始化。
variable state index solid liquid
variable target index 0.2 1.5
label states
units lj
atom_style atomic
boundary p p p
lattice fcc 0.85
region box block 0 4 0 4 0 4
create_box 1 box
create_atoms 1 box
mass 1 1
pair_style lj/cut 2.5
pair_coeff * * 1 1
pair_modify shift yes
neighbor 0.3 bin
neigh_modify every 1 delay 0 check yes
timestep 0.005
velocity all create ${target} 56789 mom yes rot no dist gaussian
fix bath all nvt temp ${target} ${target} 0.5
thermo 1000
run 5000
reset_timestep 0
comm_modify cutoff 3.3
compute radial all rdf 80 cutoff 3.0
compute movement all msd com yes
fix rdf_output all ave/time 10 50 500 c_radial[*] file rdf.${state}.dat mode vector
fix msd_output all ave/time 100 1 100 c_movement[4] file msd.${state}.dat format "%20.12g"
thermo_style custom step temp pe c_movement[4]
run 5000
clear
next state target
jump SELF states
