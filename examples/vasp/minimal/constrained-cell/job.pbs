#!/bin/bash
#PBS -N vasp-minimal
#PBS -l nodes=1:ppn=2
#PBS -l walltime=00:15:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
# 按集群说明加载软件环境，或将 EXEC 设为可执行文件的绝对路径。
EXEC="${VASP_EXEC:-vasp_optcell}"
export OMP_NUM_THREADS=1
NP=$(wc -l < "${PBS_NODEFILE:?}")
export VASP_EXEC="$EXEC"
python3 run.py --ranks "$NP"
