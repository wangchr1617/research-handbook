integrator = md
dt = 0.001
nsteps = 10000
continuation = no
gen-vel = yes
gen-temp = 300
gen-seed = 2026
constraints = h-bonds
tcoupl = v-rescale
tc-grps = System
tau-t = 0.1
ref-t = 300
pcoupl = no
cutoff-scheme = Verlet
coulombtype = PME
rcoulomb = 0.8
vdwtype = Cut-off
rvdw = 0.8
pbc = xyz
nstenergy = 100
nstlog = 100
nstxout-compressed = 100
free-energy = yes
init-lambda-state = 2
vdw-lambdas = 0 0.25 0.5 0.75 1
coul-lambdas = 0 0 0 0 0
couple-moltype = ARG
couple-lambda0 = vdw-q
couple-lambda1 = none
couple-intramol = no
sc-alpha = 0.5
sc-power = 1
sc-sigma = 0.3
calc-lambda-neighbors = -1
nstdhdl = 10
