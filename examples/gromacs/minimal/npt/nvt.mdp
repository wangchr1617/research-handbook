; 时间ps；1 fs步长用于小型刚性水演示。
integrator = md
dt = 0.001
constraints = h-bonds
constraint-algorithm = lincs
tcoupl = v-rescale
tc-grps = System
tau-t = 0.1
ref-t = 300
nstenergy = 100
nstlog = 100
nstxout-compressed = 100
nstxout = 0
nstvout = 0
nstfout = 0
cutoff-scheme = Verlet
nstlist = 10
coulombtype = PME
rcoulomb = 0.8
vdwtype = Cut-off
rvdw = 0.8
DispCorr = EnerPres
pbc = xyz
nsteps = 5000
gen-vel = yes
gen-temp = 300
gen-seed = 2026
continuation = no
pcoupl = no
