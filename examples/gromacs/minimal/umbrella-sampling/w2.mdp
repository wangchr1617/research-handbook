integrator = md
dt = 0.001
nsteps = 10000
continuation = no
gen-vel = yes
gen-temp = 300
gen-seed = 2026
constraints = h-bonds
tcoupl = v-rescale
tc-grps = System
tau-t = 0.1
ref-t = 300
pcoupl = no
cutoff-scheme = Verlet
coulombtype = PME
rcoulomb = 0.8
vdwtype = Cut-off
rvdw = 0.8
pbc = xyz
nstenergy = 100
nstlog = 100
nstxout-compressed = 100
pull = yes
pull-ncoords = 1
pull-ngroups = 2
pull-group1-name = AR1
pull-group2-name = AR2
pull-coord1-type = umbrella
pull-coord1-geometry = distance
pull-coord1-groups = 1 2
pull-coord1-dim = Y Y Y
pull-coord1-start = no
pull-coord1-init = 0.5
pull-coord1-rate = 0
pull-coord1-k = 1000
pull-nstxout = 10
pull-nstfout = 10
