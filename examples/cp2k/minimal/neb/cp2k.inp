&GLOBAL
  PROJECT neb
  RUN_TYPE BAND
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 280
      REL_CUTOFF 40
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
    &SCF
      EPS_SCF 1.0E-7
      MAX_SCF 150
      ADDED_MOS 8
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.2
        NBROYDEN 8
      &END MIXING
      &SMEAR
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE 300
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 5.43 5.43 5.43
      PERIODIC XYZ
    &END CELL
    &TOPOLOGY
      COORD_FILE_NAME replica-00.xyz
      COORD_FILE_FORMAT XYZ
    &END TOPOLOGY
    &KIND Si
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
  &PRINT
    &FORCES ON
    &END FORCES
  &END PRINT
&END FORCE_EVAL
&MOTION
  &CONSTRAINT
    &FIXED_ATOMS
      LIST 2..7
    &END FIXED_ATOMS
  &END CONSTRAINT
  &BAND
    BAND_TYPE CI-NEB
    NUMBER_OF_REPLICA 5
    NPROC_REP 1
    K_SPRING 0.05
    ALIGN_FRAMES FALSE
    ROTATE_FRAMES FALSE
    &CI_NEB
      NSTEPS_IT 0
    &END CI_NEB
    &OPTIMIZE_BAND
      OPTIMIZE_END_POINTS FALSE
      OPT_TYPE DIIS
      &DIIS
        MAX_STEPS 40
      &END DIIS
    &END OPTIMIZE_BAND
    &CONVERGENCE_CONTROL
      MAX_FORCE 5.8E-4
      RMS_FORCE 3.0E-4
      MAX_DR 0.005
      RMS_DR 0.005
    &END CONVERGENCE_CONTROL
    &CONVERGENCE_INFO ON
    &END CONVERGENCE_INFO
    &REPLICA
      COORD_FILE_NAME replica-00.xyz
    &END REPLICA
    &REPLICA
      COORD_FILE_NAME replica-04.xyz
    &END REPLICA
  &END BAND
&END MOTION
