&GLOBAL
 PROJECT periodic
 RUN_TYPE ENERGY
 PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
 METHOD Quickstep
 &DFT
  BASIS_SET_FILE_NAME BASIS_MOLOPT
  POTENTIAL_FILE_NAME GTH_POTENTIALS
  &MGRID
   CUTOFF 400
   REL_CUTOFF 50
  &END MGRID
  &QS
   EPS_DEFAULT 1.0E-12
  &END QS
  &SCF
   ADDED_MOS -1
   EPS_SCF 1.0E-8
   MAX_SCF 120
   SCF_GUESS ATOMIC
   &DIAGONALIZATION
    ALGORITHM STANDARD
   &END DIAGONALIZATION
   &MIXING
    METHOD BROYDEN_MIXING
    ALPHA 0.3
    NBROYDEN 8
   &END MIXING
  &END SCF
  &XC
   &XC_FUNCTIONAL PBE
   &END XC_FUNCTIONAL
  &END XC
  &PRINT
   &MO_MOLDEN ON
    NDIGITS 12
    UNIT ANGSTROM
    WRITE_CELL T
    WRITE_PSEUDO T
    NLUMO -1
   &END MO_MOLDEN
  &END PRINT
 &END DFT
 &SUBSYS
  &CELL
   ABC 8 8 8
   PERIODIC XYZ
  &END CELL
  &TOPOLOGY
   COORD_FILE_NAME structure.xyz
   COORD_FILE_FORMAT XYZ
  &END TOPOLOGY
  &KIND O
   BASIS_SET DZVP-MOLOPT-SR-GTH
   POTENTIAL GTH-PBE-q6
  &END KIND
  &KIND H
   BASIS_SET DZVP-MOLOPT-SR-GTH
   POTENTIAL GTH-PBE-q1
  &END KIND
 &END SUBSYS
&END FORCE_EVAL
