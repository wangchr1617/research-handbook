#!/bin/bash
#PBS -N openmx-band-str
#PBS -l nodes=1:ppn=1
#PBS -l mem=2gb
#PBS -l walltime=00:10:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
# 加载 OpenMX 环境，并设置安装数据库目录。
: "${OPENMX_DATA:?请设置 OPENMX_DATA 为 DFT_DATA19 路径}"
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
python3 run.py
python3 postprocess.py
